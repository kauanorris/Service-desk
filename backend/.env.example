# Copie este arquivo para ".env" e ajuste os valores antes de rodar a API.
# IMPORTANTE (Windows): salve este arquivo em texto puro (UTF-8 sem BOM).
# Se usar o Bloco de Notas, prefira "Salvar como" > Codificação "UTF-8",
# ou recrie o arquivo pelo PowerShell com Set-Content/Add-Content.

PORT=8080

# String de conexão com o PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/servicedesk?sslmode=disable

# Segredo usado para assinar os tokens JWT — gere um valor aleatório forte, nunca use este exemplo em produção.
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio

# Origem do frontend permitida pelo CORS
ALLOWED_ORIGIN=http://localhost:5173
